# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Comma-separated Discord Guild IDs to sync slash commands to instantly (optional).
# Commands are always synced globally too, which can take up to an hour to propagate;
# listing guild IDs here makes them show up in those specific servers immediately.
GUILD_IDS=your_guild_id_here,another_guild_id_here

# Database Configuration
DATABASE_URL=sqlite://db.sqlite3

# Sentry DSN (optional)
SENTRY_DSN=

